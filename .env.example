# WAJIB — app fail-fast (throw saat startup) kalau ini kosong/salah.
# Base URL backend engine Sinaptex, TANPA trailing slash, TANPA "/api/v1"
# (api-client.ts yang menambahkan prefix /api/v1 secara otomatis).
# Contoh: https://api.example.com  atau  http://localhost:4000
NEXT_PUBLIC_API_URL=

# WAJIB — dari dashboard Supabase project kamu (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opsional — public key VAPID untuk Web Push (generate lewat `npx web-push generate-vapid-keys`).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Opsional — set "true" untuk mematikan Service Worker saat development.
NEXT_PUBLIC_DISABLE_SW=
